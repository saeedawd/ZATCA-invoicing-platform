APP_NAME="فواتير زاتكا"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# في الإنتاج: APP_ENV=production و APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
# في الإنتاج: https://zatca.app — يُستخدم للـ canonical والـ sitemap
SEO_CANONICAL_BASE="${APP_URL}"

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=Asia/Riyadh

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zatcaapp
DB_USERNAME=root
DB_PASSWORD=

# للإنتاج مع عدة مستخدمين: SESSION_DRIVER=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# للإنتاج: QUEUE_CONNECTION=redis (أو database) مع تشغيل: php artisan queue:work --queue=zatca,default
QUEUE_CONNECTION=sync

# للإنتاج مع عدة مستخدمين: CACHE_STORE=redis ثم php artisan config:cache
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# بريد النظام — نسيت كلمة المرور (Hostinger)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=auth@zatca.app
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="auth@zatca.app"
MAIL_FROM_NAME="${APP_NAME}"

# بريد استقبال نموذج التواصل العام (بريد الشركة)
CONTACT_MAIL_TO=info@zatca.app

# بريد المستندات — فواتير / عروض أسعار
MAIL_DOCUMENTS_SCHEME=smtps
MAIL_DOCUMENTS_HOST=smtp.hostinger.com
MAIL_DOCUMENTS_PORT=465
MAIL_DOCUMENTS_USERNAME=no-reply@zatca.app
MAIL_DOCUMENTS_PASSWORD=
MAIL_DOCUMENTS_FROM_ADDRESS="no-reply@zatca.app"
MAIL_DOCUMENTS_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ZATCA_SIMULATION_MODE=false
ZATCA_SOLUTION_NAME=ZatcaApp
ZATCA_SOLUTION_VERSION=1.0.0
ZATCA_INVOICE_TYPE_CODE=1100
ZATCA_SANDBOX_BASE_URL=https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal
ZATCA_SIMULATION_BASE_URL=https://gw-fatoora.zatca.gov.sa/e-invoicing/simulation
ZATCA_PRODUCTION_BASE_URL=https://gw-fatoora.zatca.gov.sa/e-invoicing/core
